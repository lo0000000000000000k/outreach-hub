# ── Login ──
OUTREACH_PASSCODE=pick-a-long-passcode
SESSION_SECRET=any-long-random-string-at-least-32-characters

# ── Google Sheet (the lead store) ──
GOOGLE_SERVICE_ACCOUNT_EMAIL=outreach@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
LEADS_SHEET_ID=the-long-id-in-the-sheet-url
LEADS_SHEET_TAB=Leads
LOG_SHEET_TAB=Log
DEMO=0

# ── Chrome extension ──
CAPTURE_KEY=another-long-random-string

# ── Apollo (optional: find missing emails) ──
APOLLO_API_KEY=
# Daily automation may use Apollo for this many leads a day (credits!). 0 = off.
AUTO_ENRICH_PER_DAY=0

# ── Daily automation (Vercel cron, 9:00 IST) ──
CRON_SECRET=a-third-long-random-string
BOSS_TIMEZONE=Asia/Kolkata
